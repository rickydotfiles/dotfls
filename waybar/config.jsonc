// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 2,
    "width": 1366,
    "spacing": 1,
    "passthrough": false,
    
    "modules-left": [
	"hyprland/workspaces",
	"hyprland/window"
    ],
    "modules-center": [
     	"clock",
	"wireplumber"
    ],
    "modules-right": [
        "network",
        "cpu",
        "memory",
	"disk",
        "battery",
        "tray"
    ],

    "hyprland/workspaces": {
         "disable-scroll": true,
         "all-outputs": true,
         "warp-on-scroll": false,
         "format": "{name}",
	 "persistent-workspaces": {
		"*":5
	 }
     },

    "hyprland/window": {
	//"format": "{title}",
	"max-lenght": 10,
	"separate-outputs" : false
    },

    "tray": {
        "icon-size": 14,
        "spacing": 10
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}",
	"tooltip": false
    },
    "cpu": {
        "format": "CPU: {usage}%",
        "tooltip": false
    },
    
    "memory": {
        "format": "Mem: {used} GiB",
	"tooltip": false
    },

    "disk": {
	"interval": 60,
	"path": "/",
	"format": "Disk: {free}",
	"tooltip":false
    },

    //"battery": {
      //  "states": {
        //    // "good": 95,
          //  "warning:wq": 30,
            //"critical": 15
   //     },
     //   "format": "{capacity}% {icon}",
       // "format-full": "{capacity}% {icon}",
        //"format-charging": "{capacity}% ",
        //"format-plugged": "{capacity}% ",
        //"format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        //"format-icons": ["", "", "", "", ""]
  //  },
    
    "network": {
        "format": "Connected ",
        "format-disconnected": "Disconnected ⚠",
	"tooltip": false
    },

    "wireplumber": {
        "format": "{icon}",
        "format-bluetooth": "󰂰",
        "nospacing": 0,
        "tooltip-format": "Volume : {volume}%",
        "format-muted": "󰝟",
        "format-icons": {
            "headphone": "",
            "default": ["󰖀","󰕾",""]
        },
        "on-click": "pavucontrol",
        "scroll-step": 1
    },
}
